<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>RREO — Balanço Orçamentário | Campo Largo</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<style>
:root{
  --azul:#073b6f; --azul2:#0d6efd; --fundo:#eef2f6;
  --linha:#cfd5dc; --cab:#e9edf2; --sub:#f7f8fa;
}
*{box-sizing:border-box}
body{margin:0;background:var(--fundo);font-family:Arial,Helvetica,sans-serif;color:#111}
.navbar{background:var(--azul)!important}
.hero{background:linear-gradient(135deg,#073b6f,#0d6efd);color:#fff}
.card{border:0;box-shadow:0 4px 18px rgba(0,0,0,.07)}
.pdf-page{
  background:#fff; max-width:1450px; margin:24px auto; padding:24px 28px;
  box-shadow:0 2px 14px rgba(0,0,0,.12); border:1px solid #d8dde3;
}
.pdf-header{text-align:center;border-bottom:2px solid #111;padding-bottom:10px;margin-bottom:12px}
.pdf-header h1{font-size:20px;margin:0;font-weight:700}
.pdf-header h2{font-size:18px;margin:3px 0;font-weight:700}
.pdf-header h3{font-size:16px;margin:3px 0;font-weight:700}
.pdf-header .periodo{font-size:14px;font-weight:700;margin-top:7px}
.meta{font-size:12px;color:#444;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
.section-title{
  background:#dfe3e8;border:1px solid #8e959d;padding:7px 9px;
  font-weight:700;font-size:14px;text-transform:uppercase;margin-top:14px;
}
.pdf-table{width:100%;border-collapse:collapse;font-size:11px;table-layout:fixed}
.pdf-table th,.pdf-table td{border:1px solid #9da4ab;padding:4px 5px;vertical-align:middle}
.pdf-table th{background:#e5e8eb;text-align:center;font-weight:700}
.pdf-table td.num{text-align:right;white-space:nowrap}
.pdf-table td.conta{font-weight:500}
.pdf-table tr.total td{font-weight:700;background:#f0f2f4}
.pdf-table tr.subtotal td{font-weight:700;background:#f7f8fa}
.pdf-table .conta-col{width:31%}
.pdf-table .num-col{width:9.85%}
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:12px 0}
.kpi{border:1px solid #c7cdd4;border-left:5px solid var(--azul2);padding:10px;background:#fff}
.kpi .label{font-size:11px;color:#666}.kpi .valor{font-size:18px;font-weight:700;color:var(--azul)}
.small{font-size:11px}
.status{font-size:13px}
.sticky-controls{position:sticky;top:0;z-index:1000;background:rgba(238,242,246,.96);backdrop-filter:blur(5px);padding:10px 0}
.btn-primary{background:var(--azul2)}
.api-url{word-break:break-all;font-size:11px}
.footer-note{font-size:10px;color:#555;border-top:1px solid #999;margin-top:14px;padding-top:8px}
.loading{display:none}
@media(max-width:1000px){
  .pdf-page{margin:10px;padding:12px}
  .pdf-table{font-size:9px}
  .kpis{grid-template-columns:repeat(2,1fr)}
}
@media print{
  body{background:#fff}
  .no-print,.sticky-controls,.navbar,.hero{display:none!important}
  .pdf-page{box-shadow:none;border:0;margin:0;max-width:none;padding:8mm}
  .pdf-table{font-size:9px}
  @page{size:A4 landscape;margin:8mm}
}
</style>
</head>
<body>

<nav class="navbar navbar-dark no-print">
  <div class="container-fluid px-4">
    <span class="navbar-brand fw-bold"><i class="bi bi-bank2"></i> RREO — Campo Largo/PR</span>
    <span class="text-white small">SICONFI / Tesouro Nacional</span>
  </div>
</nav>

<header class="hero py-4 no-print">
  <div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
      <div>
        <span class="badge bg-light text-primary mb-2">RREO — ANEXO 01</span>
        <h1 class="h3 fw-bold mb-1">Balanço Orçamentário</h1>
        <div>Apresentação em HTML seguindo a estrutura do relatório oficial.</div>
      </div>
      <div class="text-end small">
        Município de Campo Largo — PR<br>
        Código do ente: <strong>4104204</strong>
      </div>
    </div>
  </div>
</header>

<main class="container-fluid px-3 px-lg-4">
  <div class="sticky-controls no-print">
    <div class="card">
      <div class="card-body">
        <div class="row g-2 align-items-end">
          <div class="col-6 col-md-2">
            <label class="form-label fw-semibold mb-1">Ano</label>
            <select id="ano" class="form-select">
              <option>2026</option><option>2025</option><option>2024</option><option>2023</option>
            </select>
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label fw-semibold mb-1">Período / Bimestre</label>
            <select id="periodo" class="form-select">
              <option value="1">1º Bimestre — Janeiro a Fevereiro</option>
              <option value="2">2º Bimestre — Janeiro a Abril</option>
              <option value="3">3º Bimestre — Janeiro a Junho</option>
              <option value="4">4º Bimestre — Janeiro a Agosto</option>
              <option value="5">5º Bimestre — Janeiro a Outubro</option>
              <option value="6">6º Bimestre — Janeiro a Dezembro</option>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label fw-semibold mb-1">Anexo</label>
            <input class="form-control" value="RREO-Anexo 01" disabled>
          </div>
          <div class="col-md-2">
            <button id="consultar" class="btn btn-primary w-100"><i class="bi bi-search"></i> Consultar</button>
          </div>
          <div class="col-md-1">
            <button id="imprimir" class="btn btn-outline-secondary w-100" title="Imprimir / salvar em PDF"><i class="bi bi-printer"></i></button>
          </div>
          <div class="col-md-2">
            <label class="btn btn-outline-primary w-100 mb-0">
              <i class="bi bi-file-earmark-code"></i> JSON local
              <input id="json" type="file" accept=".json" hidden>
            </label>
          </div>
        </div>
        <div class="mt-2 small-muted api-url" id="urlPreview"></div>
        <div class="alert alert-info status mt-2 mb-0" id="status">Aguardando consulta...</div>
      </div>
    </div>
  </div>

  <section class="pdf-page" id="relatorio">
    <div class="pdf-header">
      <h1>MUNICÍPIO DE CAMPO LARGO - PR</h1>
      <h2>Relatório Resumido da Execução Orçamentária</h2>
      <h3>BALANÇO ORÇAMENTÁRIO</h3>
      <div>Orçamentos Fiscal e da Seguridade Social</div>
      <div class="periodo" id="cabPeriodo">Período de Referência: Janeiro a Fevereiro de 2026 / Bimestre Janeiro-Fevereiro</div>
    </div>

    <div class="meta">
      <span>Entidade: Município de Campo Largo</span>
      <span>Exercício: <strong id="cabAno">2026</strong></span>
      <span>Anexo: RREO - Anexo 1</span>
    </div>

    <div class="kpis">
      <div class="kpi"><div class="label">Previsão/Orçamento principal</div><div class="valor" id="kpiPrev">—</div></div>
      <div class="kpi"><div class="label">Receita realizada até o bimestre</div><div class="valor" id="kpiRec">—</div></div>
      <div class="kpi"><div class="label">Despesa empenhada até o bimestre</div><div class="valor" id="kpiEmp">—</div></div>
      <div class="kpi"><div class="label">Despesa liquidada até o bimestre</div><div class="valor" id="kpiLiq">—</div></div>
    </div>

    <div class="section-title">RECEITAS</div>
    <div class="table-responsive">
      <table class="pdf-table" id="tabelaReceitas">
        <thead><tr id="headReceitas"></tr></thead>
        <tbody></tbody>
      </table>
    </div>

    <div class="section-title">DESPESAS</div>
    <div class="table-responsive">
      <table class="pdf-table" id="tabelaDespesas">
        <thead><tr id="headDespesas"></tr></thead>
        <tbody></tbody>
      </table>
    </div>

    <div class="section-title">NOTAS E FONTE</div>
    <div class="footer-note">
      FONTE: Sistema SICONFI — Tesouro Nacional / Secretaria do Tesouro Nacional. 
      Esta apresentação reorganiza os dados retornados pela API para reproduzir, em HTML, a estrutura do RREO - Anexo 01.
      A nomenclatura e os valores são preservados conforme o retorno da API.
    </div>
  </section>
</main>

<script>
const API_BASE = "https://apidatalake.tesouro.gov.br/ords/cdwhprd/siconfi/tt/rreo";
const ID_ENTE = "4104204";
const TIPO = "RREO";
const ANEXO = "RREO-Anexo 01";

const periodos = {
  1:"Janeiro a Fevereiro", 2:"Janeiro a Abril", 3:"Janeiro a Junho",
  4:"Janeiro a Agosto", 5:"Janeiro a Outubro", 6:"Janeiro a Dezembro"
};

let dados = [];

const $ = id => document.getElementById(id);

function moeda(v){
  if(v===null || v===undefined || v==="") return "—";
  if(typeof v === "number") return new Intl.NumberFormat("pt-BR",{style:"currency",currency:"BRL"}).format(v);
  let s=String(v).trim().replace(/R\\$/g,"").replace(/\\s/g,"");
  if(s.includes(",") && s.includes(".")) s=s.replace(/\\./g,"").replace(",",".");
  else if(s.includes(",")) s=s.replace(",",".");
  let n=Number(s);
  if(!Number.isFinite(n)) return String(v);
  return new Intl.NumberFormat("pt-BR",{style:"currency",currency:"BRL"}).format(n);
}
function num(v){
  if(typeof v==="number") return Number.isFinite(v)?v:0;
  if(v===null||v===undefined||v==="") return 0;
  let s=String(v).replace(/R\\$/g,"").trim();
  if(s.includes(",")&&s.includes(".")) s=s.replace(/\\./g,"").replace(",",".");
  else if(s.includes(",")) s=s.replace(",",".");
  let n=Number(s); return Number.isFinite(n)?n:0;
}
function esc(v){
  return String(v??"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
}
function mostrarStatus(msg,tipo="info"){
  $("status").className="alert alert-"+tipo+" status mt-2 mb-0";
  $("status").textContent=msg;
}
function apiUrl(){
  const p=new URLSearchParams({
    an_exercicio:$("ano").value,
    nr_periodo:$("periodo").value,
    co_tipo_demonstrativo:TIPO,
    no_anexo:ANEXO,
    id_ente:ID_ENTE
  });
  return API_BASE+"?"+p.toString();
}
function atualizarCabecalho(){
  const ano=$("ano").value, p=$("periodo").value;
  $("cabAno").textContent=ano;
  $("cabPeriodo").textContent=`Período de Referência: ${periodos[p]} de ${ano} / Bimestre ${p}`;
  $("urlPreview").textContent="URL consultada: "+apiUrl();
}

function extrairItems(json){
  if(Array.isArray(json)) return json;
  if(Array.isArray(json.items)) return json.items;
  if(Array.isArray(json.retorno)) return json.retorno;
  if(Array.isArray(json.data)) return json.data;
  return [];
}
function campo(o, chaves){
  for(const k of chaves){
    if(o[k]!==undefined && o[k]!==null && o[k]!=="") return o[k];
  }
  return "";
}
function normalizar(lista){
  return lista.map((x,i)=>({
    id:i,
    ano:campo(x,["an_exercicio","exercicio","ano"]),
    periodo:campo(x,["nr_periodo","periodo"]),
    anexo:campo(x,["no_anexo","anexo"]),
    conta:campo(x,["ds_conta","descricao_conta","conta","no_conta","desc_conta"]),
    codigo:campo(x,["co_conta","codigo_conta","cod_conta","codigo"]),
    coluna:campo(x,["no_coluna","coluna","ds_coluna","descricao_coluna"]),
    valor:campo(x,["vl_conta","valor","vlr_conta","value"])
  }));
}

function normalizarColuna(c){
  return String(c||"").normalize("NFD").replace(/[\\u0300-\\u036f]/g,"").toUpperCase().replace(/\\s+/g," ").trim();
}
function isRevenue(item){
  const c=normalizarColuna(item.coluna)+" "+normalizarColuna(item.conta);
  return /PREVISAO|RECEITAS|RECEITA|ALIENACAO|TRANSFERENCIAS/.test(c) && !/DOTACAO|EMPENHAD|LIQUIDAD|PAGAS/.test(c);
}
function isExpense(item){
  const c=normalizarColuna(item.coluna)+" "+normalizarColuna(item.conta);
  return /DOTACAO|EMPENHAD|LIQUIDAD|PAGAS|DESPESAS|RESERVA/.test(c);
}
function shortColuna(c){
  const n=normalizarColuna(c);
  const map=[
    ["PREVISAO INICIAL","Previsão inicial"],["PREVISÃO INICIAL","Previsão inicial"],
    ["PREVISAO ATUALIZADA","Previsão atualizada"],["PREVISÃO ATUALIZADA","Previsão atualizada"],
    ["NO BIMESTRE","No bimestre"],["ATE O BIMESTRE","Até o bimestre"],["ATÉ O BIMESTRE","Até o bimestre"],
    ["DOTAÇÃO INICIAL","Dotação inicial"],["DOTACAO INICIAL","Dotação inicial"],
    ["DOTAÇÃO ATUALIZADA","Dotação atualizada"],["DOTACAO ATUALIZADA","Dotação atualizada"],
    ["DESPESAS EMPENHADAS NO BIMESTRE","Empenhadas no bimestre"],
    ["DESPESAS EMPENHADAS ATÉ O BIMESTRE","Empenhadas até o bimestre"],
    ["DESPESAS LIQUIDADAS NO BIMESTRE","Liquidadas no bimestre"],
    ["DESPESAS LIQUIDADAS ATÉ O BIMESTRE","Liquidadas até o bimestre"],
    ["DESPESAS PAGAS ATÉ O BIMESTRE","Pagas até o bimestre"],
    ["SALDO","Saldo"]
  ];
  for(const [a,b] of map) if(n.includes(a)) return b;
  return c||"Valor";
}

function agrupar(lista){
  const map=new Map();
  for(const x of lista){
    const chave=x.codigo || x.conta || ("linha-"+x.id);
    if(!map.has(chave)) map.set(chave,{codigo:x.codigo,conta:x.conta,cols:[]});
    map.get(chave).cols.push(x);
  }
  return [...map.values()];
}
function obterValor(grupo, termos){
  for(const item of grupo.cols){
    const n=normalizarColuna(item.coluna);
    if(termos.some(t=>n.includes(t))) return item.valor;
  }
  return null;
}

const receitaCols=[
  {h:"Previsão inicial",t:["PREVISAO INICIAL"]},
  {h:"Previsão atualizada",t:["PREVISAO ATUALIZADA"]},
  {h:"No bimestre",t:["NO BIMESTRE"]},
  {h:"% No bimestre",t:["% (B/A)"]},
  {h:"Até o bimestre",t:["ATE O BIMESTRE","ATÉ O BIMESTRE"]},
  {h:"% Até o bimestre",t:["% (C/A)"]},
  {h:"Saldo",t:["SALDO"]}
];
const despesaCols=[
  {h:"Dotação inicial",t:["DOTACAO INICIAL"]},
  {h:"Dotação atualizada",t:["DOTACAO ATUALIZADA"]},
  {h:"Empenhadas no bimestre",t:["DESPESAS EMPENHADAS NO BIMESTRE","NO BIMESTRE"]},
  {h:"Empenhadas até o bimestre",t:["DESPESAS EMPENHADAS ATÉ O BIMESTRE","EMPENHADAS ATE O BIMESTRE"]},
  {h:"Saldo",t:["SALDO"]},
  {h:"Liquidadas no bimestre",t:["DESPESAS LIQUIDADAS NO BIMESTRE"]},
  {h:"Liquidadas até o bimestre",t:["DESPESAS LIQUIDADAS ATÉ O BIMESTRE"]},
  {h:"Pagas até o bimestre",t:["DESPESAS PAGAS ATÉ O BIMESTRE","PAGAS ATÉ O BIMESTRE"]}
];

function renderTable(id,headId,groups,cols){
  $(headId).innerHTML='<th class="conta-col">Conta</th>'+cols.map(c=>`<th class="num-col">${esc(c.h)}</th>`).join("");
  const tbody=$(id).querySelector("tbody");
  if(!groups.length){
    tbody.innerHTML='<tr><td colspan="'+(cols.length+1)+'" class="text-center py-4">Nenhum registro retornado para esta consulta.</td></tr>';
    return;
  }
  tbody.innerHTML=groups.map(g=>{
    const texto=(g.codigo?esc(g.codigo)+" — ":"")+esc(g.conta||"");
    const destaque=/^(RECEITAS|DESPESAS|SUBTOTAL|TOTAL|SUPERAVIT|DEFICIT|RESERVA)/i.test(String(g.conta||"").trim());
    return `<tr class="${destaque?'subtotal':''}">
      <td class="conta">${texto}</td>
      ${cols.map(c=>`<td class="num">${esc(moeda(obterValor(g,c.t)))}</td>`).join("")}
    </tr>`;
  }).join("");
}

function atualizarKPIs(groupsRec,groupsDesp){
  const rec=groupsRec.find(g=>/RECEITAS \\(EXCETO INTRA|TOTAL DAS RECEITAS|SUBTOTAL DAS RECEITAS/i.test(g.conta||""));
  const desp=groupsDesp.find(g=>/DESPESAS \\(EXCETO INTRA|TOTAL DAS DESPESAS|SUBTOTAL DAS DESPESAS/i.test(g.conta||""));
  $("kpiPrev").textContent=rec?moeda(obterValor(rec,["PREVISAO ATUALIZADA","PREVISÃO ATUALIZADA"])):"—";
  $("kpiRec").textContent=rec?moeda(obterValor(rec,["ATE O BIMESTRE","ATÉ O BIMESTRE"])):"—";
  $("kpiEmp").textContent=desp?moeda(obterValor(desp,["DESPESAS EMPENHADAS ATÉ O BIMESTRE","EMPENHADAS ATE O BIMESTRE"])):"—";
  $("kpiLiq").textContent=desp?moeda(obterValor(desp,["DESPESAS LIQUIDADAS ATÉ O BIMESTRE"])):"—";
}

function render(){
  const n=normalizar(dados);
  const rec=n.filter(isRevenue), desp=n.filter(isExpense);
  const gr=agrupar(rec), gd=agrupar(desp);
  renderTable("tabelaReceitas","headReceitas",gr,receitaCols);
  renderTable("tabelaDespesas","headDespesas",gd,despesaCols);
  atualizarKPIs(gr,gd);
  $("urlPreview").textContent="URL consultada: "+apiUrl();
}

async function consultar(){
  atualizarCabecalho();
  mostrarStatus("Consultando o SICONFI...","info");
  try{
    const r=await fetch(apiUrl(),{headers:{Accept:"application/json"}});
    if(!r.ok) throw new Error("HTTP "+r.status);
    const json=await r.json();
    dados=extrairItems(json);
    if(!dados.length) throw new Error("A API respondeu sem registros.");
    render();
    mostrarStatus(`${dados.length.toLocaleString("pt-BR")} registros retornados pelo SICONFI.`,"success");
  }catch(e){
    console.error(e);
    mostrarStatus("Não foi possível consultar a API diretamente no navegador. Verifique CORS/conexão ou use o botão JSON local. Detalhe: "+e.message,"danger");
    dados=[];
    render();
  }
}

$("consultar").addEventListener("click",consultar);
$("imprimir").addEventListener("click",()=>window.print());
$("ano").addEventListener("change",atualizarCabecalho);
$("periodo").addEventListener("change",atualizarCabecalho);
$("json").addEventListener("change",ev=>{
  const f=ev.target.files[0]; if(!f)return;
  const rd=new FileReader();
  rd.onload=()=>{
    try{
      dados=extrairItems(JSON.parse(rd.result));
      if(!dados.length) throw new Error("JSON sem itens.");
      render();
      atualizarCabecalho();
      mostrarStatus(`${dados.length.toLocaleString("pt-BR")} registros carregados do JSON local.`,"success");
    }catch(e){mostrarStatus("Erro ao ler o JSON: "+e.message,"danger");}
  };
  rd.readAsText(f,"utf-8");
});

atualizarCabecalho();
consultar();
</script>
</body>
</html>
